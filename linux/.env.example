# Salin file ini jadi ".env" lalu isi nilainya. Baris bertanda (!) WAJIB
# diganti untuk production — startup akan gagal (fail-fast) kalau JWT_SECRET
# atau ADMIN_PASSWORD masih nilai default saat APP_ENV=production.

# Server
APP_ENV=development          # ganti ke "production" saat deploy sungguhan
APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=siuji_user
DB_PASSWORD=changeme         # (!) ganti, jangan sampai kebawa "changeme" ke production
DB_NAME=siuji_db
DB_SSLMODE=disable           # ganti ke "require" kalau DB diakses lewat jaringan publik

# Redis (untuk session timer ujian & cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (autentikasi access/refresh token)
JWT_SECRET=super-secret-key-ganti-ini  # (!) WAJIB: string acak panjang (>=32 karakter), unik per deployment
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_HOURS=168  # boleh desimal (mis. 0.01 = 36 detik) untuk uji coba kedaluwarsa sesi

# Kunci enkripsi salinan password siswa (untuk cetak Kartu Ujian). Opsional:
# kalau kosong, kunci diturunkan dari JWT_SECRET. Disarankan diisi terpisah di
# production supaya rotasi JWT_SECRET tidak memutus salinan yang sudah ada.
PASSWORD_ENC_KEY=

# Akun admin awal, dibuat otomatis saat startup jika belum ada admin sama sekali
ADMIN_EMAIL=admin@siuji.local
ADMIN_PASSWORD=admin12345      # (!) WAJIB: password kuat, min 8 karakter, ganti setelah login pertama

# Folder disk lokal
UPLOAD_DIR=./uploads          # foto siswa
BACKUP_DIR=./backups          # hasil pg_dump (fitur Backup)

# Path ke binary pg_dump/pg_restore — BOLEH DIBIARKAN DEFAULT, aplikasi
# otomatis mendeteksi lokasinya (PATH sistem, lalu lokasi instalasi umum
# seperti Program Files/Laragon di Windows) kalau env var ini tidak diisi
# atau nilainya tidak ditemukan. Isi manual hanya kalau instalasinya tidak
# lazim dan auto-detect gagal menemukannya.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Alamat JSON manifest versi terbaru siuji (repo publik resmi Nifadigital,
# https://github.com/arrido92/siuji-releases — cuma berisi binary hasil
# build, bukan source code) untuk fitur cek/terapkan update di panel admin.
# Instalasi BARU lewat wizard setup otomatis dapat nilai ini tanpa perlu isi
# manual (lihat defaultUpdateManifestURL di setup_handler.go) — baris di
# bawah ini murni untuk instalasi yang .env-nya ditulis manual (bukan lewat
# wizard). Kosongkan kalau tidak mau fitur cek-update aktif sama sekali; panel
# admin akan selalu melaporkan "tidak ada update" (bukan error), bukan gagal.
# Auto-update dari tombol di panel HANYA berfungsi di Linux yang terdaftar
# sebagai systemd service (otomatis oleh wizard setup kalau dijalankan
# sebagai root) — Windows dan Linux tanpa systemd tetap harus update manual
# (ganti file binary), meski UPDATE_MANIFEST_URL ini diisi.
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/arrido92/siuji-releases/main/manifest.json

# Lokasi disk file lisensi (.sig) yang diunggah admin lewat panel Pengaturan —
# lihat internal/usecase/license.go. Tidak wajib diisi: kalau file belum ada
# di path ini, aplikasi otomatis berjalan mode FREE TIER (lihat
# usecase.FreeTierMaxStudents), bukan gagal start.
LICENSE_FILE_PATH=license.sig

# Alamat check-in periodik lisensi ke server Nifadigital (lihat
# internal/usecase/license_checkin.go) -- opsional, KOSONGKAN kalau tidak
# mau fitur pencabutan lisensi jarak jauh aktif sama sekali. Verifikasi
# tanda tangan offline (LICENSE_FILE_PATH di atas) TETAP berfungsi normal
# terlepas dari ini -- check-in cuma lapisan TAMBAHAN, bukan pengganti.
LICENSE_CHECKIN_URL=

# Catatan: kunci Aplikasi Desktop Siuji (dulu DESKTOP_CLIENT_SECRET di sini)
# sekarang di-generate & disimpan di database lewat menu Ujian Aman — tidak
# ada lagi env var untuk itu.
