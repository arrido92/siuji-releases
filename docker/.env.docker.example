# KHUSUS instalasi Docker -- salin jadi ".env" di folder yang sama dengan
# docker-compose.yml, lalu isi nilai di bawah SEBELUM `docker compose up -d`.
#
#   cp .env.docker.example .env
#
# (Untuk instalasi native Windows/Linux tanpa Docker, pakai .env.example biasa,
# BUKAN file ini -- variabelnya beda karena banyak hal di sini sudah otomatis
# diatur lewat Dockerfile/docker-compose.yml.)

# --- Database ---
# Jangan tambah DB_HOST/DB_PORT di sini -- itu nama service internal Docker
# ("db"), sudah diatur otomatis di docker-compose.yml, bukan sesuatu yang
# perlu/boleh diisi manual.
DB_USER=siuji
DB_PASSWORD=

# --- Keamanan -- WAJIB diisi nilai unik, JANGAN kosongkan ---
# Generate lewat: openssl rand -hex 32
JWT_SECRET=

# --- Akun admin pertama ---
# Email boleh dibiarkan default (bisa diganti nanti lewat menu Profil setelah
# login) -- password WAJIB diisi sendiri, minimal 8 karakter. Jangan pakai
# "admin12345" -- nilai itu akan ditolak server (fail-fast) kalau
# APP_ENV=production.
ADMIN_EMAIL=admin@siuji.local
ADMIN_PASSWORD=

# --- Update otomatis (tombol "Update Sekarang" di panel admin) ---
# Token yang dipakai app untuk memanggil watchtower (container terpisah
# yang pegang akses Docker socket) -- lihat cmd/api/update_docker.go.
# Generate lewat: openssl rand -hex 32
WATCHTOWER_HTTP_API_TOKEN=

# --- Lain-lain (opsional, boleh dibiarkan default) ---
APP_PORT=8080
APP_ENV=production

# Check-in periodik lisensi ke server Nifadigital (opsional, kosongkan
# kalau tidak perlu). Verifikasi lisensi offline tetap jalan normal
# terlepas dari ini.
LICENSE_CHECKIN_URL=
